# ==============================================================================
# Production Asynchronous Streaming & Batch Worker Container
# ==============================================================================
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install system runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy source code and ML artifacts
COPY schemas.py db_models.py normalization_engine.py crop_repository.py universal_engine.py streaming_pipeline.py worker_entrypoint.py config.py ./
COPY data/ ./data/
COPY outputs/ ./outputs/

# Security user
RUN useradd -m -u 1001 appuser && \
    chown -R appuser:appuser /app
USER appuser

CMD ["python", "worker_entrypoint.py"]
